# Current Kagi API key for /api/v1 endpoints such as Search API and Extract.
KAGI_API_KEY=

# Legacy Kagi API token for /api/v0 endpoints such as FastGPT, Summarizer, and Enrich.
KAGI_API_TOKEN=

# Required for lens-aware search and the proven HTML/session path.
KAGI_SESSION_TOKEN=

# Mail uses separate OAuth credentials. Set private connection details locally.
KAGI_MAIL_ENDPOINT=
KAGI_MAIL_CLIENT_ID=
# Optional existing OAuth bearer token; otherwise run `kagi mail login`.
KAGI_MAIL_ACCESS_TOKEN=
