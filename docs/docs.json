{
  "$schema": "https://mintlify.com/docs.json",
  "name": "kagi",
  "description": "Documentation for the kagi CLI, a command-line interface and MCP server for Kagi search, summarization, extraction, and automation.",
  "theme": "maple",
  "colors": {
    "primary": "#ffb319",
    "light": "#ffc85a",
    "dark": "#18181a"
  },
  "logo": {
    "light": "/images/kagi-cli-logo-light.svg",
    "dark": "/images/kagi-cli-logo-dark.svg"
  },
  "favicon": "/images/favicon.png",
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "og:site_name": "kagi CLI documentation",
      "twitter:site": "@JustMicrock",
      "twitter:creator": "@JustMicrock"
    },
    "organization": {
      "id": "https://micr.dev/#identity",
      "name": "Microck",
      "url": "https://micr.dev",
      "logo": "https://kagi.micr.dev/images/kagi-cli-logo-light.svg",
      "sameAs": [
        "https://github.com/Microck",
        "https://x.com/JustMicrock",
        "https://www.youtube.com/@Microck"
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/Microck/kagi-cli"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/kagi-cli"
        },
        {
          "anchor": "Kagi",
          "href": "https://kagi.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "guides/installation",
              "guides/quickstart",
              "guides/authentication"
            ]
          },
          {
            "group": "Usage",
            "pages": [
              "guides/workflows",
              "guides/advanced-usage",
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Commands",
        "groups": [
          {
            "group": "Core Commands",
            "pages": [
              "commands/search",
              "commands/batch",
              "commands/auth",
              "commands/usage",
              "commands/summarize",
              "commands/extract",
              "commands/watch",
              "commands/notify",
              "commands/history",
              "commands/skills",
              "commands/mcp"
            ]
          },
          {
            "group": "Content & Feeds",
            "pages": [
              "commands/news",
              "commands/smallweb"
            ]
          },
          {
            "group": "AI & Enrichment",
            "pages": [
              "commands/assistant",
              "commands/quick",
              "commands/ask-page",
              "commands/translate",
              "commands/fastgpt",
              "commands/enrich"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "commands/lens",
              "commands/bang",
              "commands/redirect",
              "commands/site-pref"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Authentication & Security",
            "pages": [
              "reference/auth-matrix"
            ]
          },
          {
            "group": "Technical Reference",
            "pages": [
              "reference/output-contract",
              "reference/error-reference",
              "reference/coverage"
            ]
          }
        ]
      },
      {
        "tab": "Project",
        "groups": [
          {
            "group": "Development",
            "pages": [
              "project/development",
              "project/demos"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "project/support",
              "project/contributing"
            ]
          }
        ]
      }
    ]
  }
}
